&pmi8998_pdphy {
 src-pdo = <0x0 5000 900 0>;
 snk-pdo = <0x0 5000 3000 0>,
  <0x0 9000 3000 0>;
 max-snk-mv = <9000>;
 max-snk-ma = <3000>;
 max-snk-mw = <27000>;
 op-snk-mw = <7600>;
 port-type = <0x2>;
 default-role = <0x0>;
 try-role-hw;
};
# 31 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2

&reserved_memory {
 alt_ramoops_mem: alt_ramoops_region@b0e00000 {
  compatible = "removed-dma-pool";
  no-map;
  reg = <0 0xb0e00000 0 0x200000>;
 };

 ramoops_mem: ramoops_region@b0000000 {
  compatible = "removed-dma-pool";
  no-map;
  reg = <0 0xb0000000 0 0x200000>;
 };

 ramoops_meta_mem: ramoops_meta_region@affff000 {
  compatible = "removed-dma-pool";
  no-map;
  reg = <0 0xaffff000 0 0x1000>;
 };

 crash_fb_mem@b0200000 {
  linux,contiguous-region;
  reg = <0 0xb0200000 0 0xc00000>;
  label = "crash_fb_mem";
 };

 easel_mem: easel_mem@96000000 {
  linux,contiguous-region;
  reg = <0 0x96000000 0 0x4000000>;
  label = "easel_mem";
 };

 cont_splash_mem: splash_region@9d600000 {
  status = "disabled";
 };

 bootloader_log_mem: bootloader_log_region@affffc000 {
  compatible = "removed-dma-pool";
  no-map;
  reg = <0 0xafffc000 0 0x3000>;
 };
};

&pil_ipa_gpu_mem {
 reg = <0 0x95a00000 0 0x100000>;
};

&pil_slpi_mem {
 reg = <0 0x94b00000 0 0xf00000>;
};

&pil_mba_mem {
 reg = <0 0x94900000 0 0x200000>;
};

&pil_video_mem {
 reg = <0 0x94400000 0 0x500000>;
};

&modem_mem {
 reg = <0 0x8cc00000 0 0x7800000>;
};

&soc {
 qcom,wdt@17817000 {
  qcom,bark-time = <16000>;
 };

 access_ramoops@0 {
  compatible = "access_ramoops";
  label = "metadata";
  memory-region = <&ramoops_meta_mem>;
 };

 access_ramoops@1 {
  compatible = "access_ramoops";
  label = "ramoops";
  memory-region = <&alt_ramoops_mem>;
 };

 ramoops {
  compatible = "ramoops";
  memory-region = <&ramoops_mem>;
  alt-memory-region = <&alt_ramoops_mem>;
  record-size = <0x0 0x20000>;
  console-size = <0x0 0x100000>;
  pmsg-size = <0x0 0x80000>;
 };

 crash_fb {
  compatible = "crash_fb";
  mem-addr = <0xb0200000>;
  mem-size = <0xc00000>;
 };

 bootlog {
  compatible = "bootlog";
 };

 qcom,ion {
  qcom,ion-heap@30 {
   reg = <30>;
   memory-region = <&easel_mem>;
   qcom,ion-heap-type = "CARVEOUT";
  };
 };

 bootloader_log {
  compatible = "htc,bldr_log";

  reg = <0xafffc000 0x1e92>;
  reg-names = "bl_log";
  memory-region = <&bootloader_log_mem>;
 };
};

&blsp1_uart3_hs {
 status = "ok";
};

&ufsphy1 {
 vdda-phy-supply = <&pm8998_l1>;
 vdda-pll-supply = <&pm8998_l2>;
 vddp-ref-clk-supply = <&pm8998_l26>;
 vdda-phy-max-microamp = <51400>;
 vdda-pll-max-microamp = <14600>;
 vddp-ref-clk-max-microamp = <100>;
 vddp-ref-clk-always-on;
 status = "ok";
};

&ufs1 {
 vdd-hba-supply = <&gdsc_ufs>;
 vdd-hba-fixed-regulator;
 vcc-supply = <&pm8998_l20>;
 vccq-supply = <&pm8998_l26>;
 vccq2-supply = <&pm8998_s4>;
 vcc-max-microamp = <750000>;
 vccq-max-microamp = <560000>;
 vccq2-max-microamp = <750000>;
 status = "ok";
};

&ufs_ice {
 status = "ok";
};

&uartblsp2dm1 {
 status = "ok";
 pinctrl-names = "default";
 pinctrl-0 = <&uart_console_active>;
};

&pm8998_gpios {

 gpio@c500 {
  status = "okay";
  qcom,mode = <0>;
  qcom,pull = <0>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,out-strength = <1>;
 };

 gpio@cc00 {
  qcom,mode = <1>;
  qcom,output-type = <0>;
  qcom,pull = <5>;
  qcom,vin-sel = <0>;
  qcom,out-strength = <1>;
  qcom,src-sel = <3>;
  qcom,master-en = <1>;
  status = "okay";
 };


 gpio@d100 {
  qcom,mode = <0>;
  qcom,pull = <0>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,master-en = <1>;
  status = "okay";
 };
};

&mdss_dp_ctrl {
 status = "disabled";
};

&wil6210 {
 status = "disabled";
};

&firmware_android {
 compatible = "android,firmware";
 vbmeta {
  compatible = "android,vbmeta";
  parts = "vbmeta,boot,system,vendor,dtbo,laf";
  by_name_prefix = "/dev/block/platform/soc/1da4000.ufshc/by-name";
 };
};
# 17 "arch/arm64/boot/dts/lge/overlay-taimen-rev-0.dts" 2

&soc {
 pinctrl@03400000 {
  pmx_mdss {
   mdss_dsi_active {
    mux {
     pins = "gpio94", "gpio133", "gpio21", "gpio100";
    };
    config {
     pins = "gpio94", "gpio133", "gpio21", "gpio100";
    };
   };
   mdss_dsi_suspend {
    mux {
     pins = "gpio94", "gpio133", "gpio21", "gpio100";
    };
    config {
     pins = "gpio94", "gpio133", "gpio21", "gpio100";
    };
   };
  };
 };
};

&pm8998_vadc {
 chan@83 {
  label = "vph_pwr";
  reg = <0x83>;
  qcom,decimation = <2>;
  qcom,pre-div-channel-scaling = <1>;
  qcom,calibration-type = "absolute";
  qcom,scale-function = <0>;
  qcom,hw-settle-time = <0>;
  qcom,fast-avg-setup = <0>;
 };
};

