&soc {
 sw49408_dsc_qhd_panel_pwr_supply: sw49408_dsc_qhd_panel_pwr_supply {
  #address-cells = <1>;
  #size-cells = <0>;

  qcom,panel-supply-entry@0 {
   reg = <0>;
   qcom,supply-name = "lab";
   qcom,supply-min-voltage = <4600000>;
   qcom,supply-max-voltage = <6000000>;
   qcom,supply-enable-load = <100000>;
   qcom,supply-disable-load = <100>;
  };

  qcom,panel-supply-entry@1 {
   reg = <1>;
   qcom,supply-name = "ibb";
   qcom,supply-min-voltage = <4600000>;
   qcom,supply-max-voltage = <6000000>;
   qcom,supply-enable-load = <100000>;
   qcom,supply-disable-load = <100>;
   qcom,supply-post-on-sleep = <10>;
  };
 };
};


&labibb {
 status = "okay";
 qcom,qpnp-labibb-mode = "lcd";

 qcom,ibb@dc00 {
  qcom,qpnp-ibb-init-voltage = <5500000>;
  qcom,qpnp-ibb-init-lcd-voltage = <5500000>;
  qcom,qpnp-ibb-discharge-resistor = <300>;
  qcom,qpnp-ibb-lab-pwrup-delay = <1000>;
  qcom,qpnp-ibb-lab-pwrdn-delay = <2000>;
 };
 qcom,lab@de00 {
  qcom,qpnp-lab-init-voltage = <5400000>;
  qcom,qpnp-lab-init-lcd-voltage = <5400000>;
 };
};

&mdss_fb0 {
 qcom,cont-splash-memory {
  linux,contiguous-region = <>;
 };
};
# 17 "arch/arm64/boot/dts/lge/msm8998-taimen-panel.dtsi" 2

&mdss_mdp {
 qcom,mdss-pref-prim-intf = "dsi";
};

&mdss_dsi {
 hw-config = "single_dsi";
};

&mdss_dsi0 {
 qcom,dsi-pref-prim-pan = <>;
 pinctrl-names = "mdss_default", "mdss_sleep";
 pinctrl-0 = <&mdss_dsi_active &mdss_te_active>;
 pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
 qcom,platform-reset-gpio = <&tlmm 94 0>;
 qcom,platform-te-gpio = <&tlmm 10 0>;
 qcom,platform-extra-ldo-vddio-gpio = <&tlmm 133 0>;
 qcom,platform-extra-ldo-vpnl-gpio = <&tlmm 21 0>;
 wqhd-vddio-supply = <>;
 interrupt-parent = <&tlmm>;
 interrupts = <11 0x2001>;
 qcom,platform-error-detect-gpio = <&tlmm 11 0x2001>;
};

&mdss_dsi1 {
 status = "disabled";
};

&dsi_sw43402_dsc_qhd_cmd_rev1 {
 qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";

 qcom,panel-supply-entries = <&dsi_panel_pwr_supply_no_labibb>;
 qcom,mdss-dsi-panel-timings = [00 15 05 05 20 1F 05 05 03 03 04 00];
 qcom,mdss-dsi-t-clk-post = <0x0B>;
 qcom,mdss-dsi-t-clk-pre = <0x23>;
 qcom,mdss-dsi-bl-max-level = <225>;
 qcom,alpm-bl-threshold = <21>;
 qcom,alpm-dim-threshold = <6>;
};

&dsi_sw43402_dsc_qhd_cmd_rev2 {
 qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";

 qcom,panel-supply-entries = <&dsi_panel_pwr_supply_no_labibb>;
 qcom,mdss-dsi-panel-timings = [00 15 05 05 20 1F 05 05 03 03 04 00];
 qcom,mdss-dsi-t-clk-post = <0x0B>;
 qcom,mdss-dsi-t-clk-pre = <0x23>;
 qcom,mdss-dsi-bl-max-level = <225>;
 qcom,alpm-bl-threshold = <21>;
 qcom,alpm-dim-threshold = <6>;
};

&dsi_sw43402_dsc_qhd_cmd {
 qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";

 qcom,panel-supply-entries = <&dsi_panel_pwr_supply_no_labibb>;
 qcom,mdss-dsi-panel-timings = [00 15 05 05 20 1F 05 05 03 03 04 00];
 qcom,mdss-dsi-t-clk-post = <0x0B>;
 qcom,mdss-dsi-t-clk-pre = <0x23>;
 qcom,mdss-dsi-bl-max-level = <225>;
 qcom,alpm-bl-threshold = <21>;
 qcom,alpm-dim-threshold = <6>;
};

&dsi_sw49408_dsc_qhd_cmd {
 qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_wled";
 qcom,mdss-dsi-bl-min-level = <1>;
 qcom,mdss-dsi-bl-max-level = <4095>;
 qcom,panel-supply-entries = <&sw49408_dsc_qhd_panel_pwr_supply>;

 qcom,mdss-dsi-panel-timings = [00 18 05 05 09 0F 05 06 04 03 04 00];
 qcom,mdss-dsi-t-clk-post = <0x07>;
 qcom,mdss-dsi-t-clk-pre = <0x24>;
};



&soc {
 gpio_keys {
  compatible = "gpio-keys";
  input-name = "gpio-keys";

  pinctrl-names = "tlmm_gpio_key_active","tlmm_gpio_key_suspend";
  pinctrl-0 = <&hallic_gpio_active>;
  pinctrl-1 = <&hallic_gpio_suspend>;

  hall_ic {
   label = "hall_ic";
   gpios = <&tlmm 124 0x1>;
   linux,input-type = <5>;
   linux,code = <222>;
   gpio-key,wakeup;
   debounce-interval = <15>;
  };
 };
};
# 19 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-sound.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-sound.dtsi"
&spi_2 {
 status = "ok";
};

&mdss_hdmi_tx {
 status = "disabled";
};

&soc {
 sound-9335 {
  status = "disabled";
 };

 msm_cdc_pinctrl@59 {
  status = "disabled";
 };

 msm_cdc_pinctrl@60 {
  status = "disabled";
 };

 msm_cdc_pinctrl@75 {
  status = "disabled";
 };

 sound-tavil {
  qcom,model = "msm8998-tavil-taimen-snd-card";
  qcom,audio-routing =
   "RX_BIAS", "MCLK",
   "MADINPUT", "MCLK",
   "AMIC1", "MIC BIAS1",
   "MIC BIAS1", "Handset Mic",
   "AMIC2", "MIC BIAS2",
   "MIC BIAS2", "Headset Mic",
   "AMIC3", "MIC BIAS3",
   "MIC BIAS3", "Handset 2nd Mic",
   "AMIC4", "MIC BIAS4",
   "MIC BIAS4", "Handset 3rd Mic",
   "DMIC0", "MIC BIAS1",
   "MIC BIAS1", "Digital Mic0",
   "DMIC1", "MIC BIAS1",
   "MIC BIAS1", "Digital Mic1",
   "DMIC2", "MIC BIAS3",
   "MIC BIAS3", "Digital Mic2",
   "DMIC3", "MIC BIAS3",
   "MIC BIAS3", "Digital Mic3",
   "DMIC4", "MIC BIAS4",
   "MIC BIAS4", "Digital Mic4",
   "DMIC5", "MIC BIAS4",
   "MIC BIAS4", "Digital Mic5",
   "SpkrLeft IN", "SPK1 OUT",
   "SpkrRight IN", "SPK2 OUT";

  qcom,us-euro-gpios = <>;
  qcom,hph-en0-gpio = <>;
  qcom,hph-en1-gpio = <>;
  qcom,wsa-max-devs = <0>;

  wahoo,use-external-amp;
  wahoo,external-amp-be-sname = "Quaternary MI2S Playback";

  wahoo,external-amp-be-codec-phandle = <&ti_tas2557_4d>;

  wahoo,external-amp-be-codec-dai-name = "tas2557 Stereo ASI1";
 };

 qcom,msm-dai-mi2s {
  qcom,msm-dai-q6-mi2s-quat {
   qcom,msm-mi2s-rx-lines = <2>;
   qcom,msm-mi2s-tx-lines = <1>;
   qcom,msm-mi2s-slave = <0>;
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&quat_mi2s_active
         &quat_mi2s_sd0_active
         &quat_mi2s_sd1_active>;
   pinctrl-1 = <&quat_mi2s_sleep
         &quat_mi2s_sd0_sleep
         &quat_mi2s_sd1_sleep>;
  };
 };

 audio_ext_clk_lnbb {
  status = "disabled";
 };

 i2c@c1b5000 {
  tfa98xx@34 {
   compatible = "nxp,tfa98xx";
   status = "ok";
   reg = <0x34>;
  };

  nxp_tfa98xx_amp@34 {
    compatible = "nxp,tfa98xx";
    reg = <0x34>;
    reset-gpio = <&pm8998_gpios 6 0x1>;
    upper-spk;
    status = "disabled";
  };

  nxp_tfa98xx_amp@35 {
    compatible = "nxp,tfa98xx";
    reg = <0x35>;
    reset-gpio = <&pm8998_gpios 7 0x1>;
    status = "disabled";
  };

  ti_tas2557_4d: tas2557s@4d {
    #sound-dai-cells = <1>;
    compatible = "ti,tas2557s";
    reg = <0x4d>;
    ti,reset-gpio-left = <&pm8998_gpios 6 0>;
    ti,reset-gpio-right = <&pm8998_gpios 6 0>;
    ti,irq-gpio-left = <&pm8998_gpios 7 0>;
    ti,irq-gpio-right = <&pm8998_gpios 8 0>;
    ti,left-channel = <0x4c>;
    ti,right-channel = <0x4d>;
    ti,echo-ref = <0>;
    ti,i2s-bits = <24>;
    ti,cal-file-name = "tas2557_cal.bin";
    ti,bypass-tmax = <0>;
    status = "ok";
  };
 };

};

&slim_aud {
 tasha_codec {
  status = "disabled";
 };

 swr_master {
  status = "disabled";
 };

 tavil_codec {
  clocks = <&clock_audio 0xcbfe416d>;
  wcd_spi {
   qcom,master-bus-num = <2>;
  };
  swr_master {
   status = "disabled";
  };
 };
};


&pm8998_gpios {

 gpio@c900 {
  qcom,master-en = <1>;
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,out-strength = <1>;
  status = "okay";
 };


 gpio@cb00 {
  qcom,master-en = <1>;
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,out-strength = <1>;
  status = "okay";
 };


 gpio@c500 {
  qcom,mode = <1>;
  qcom,pull = <5>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,master-en = <1>;
  qcom,out-strength = <1>;
  status = "ok";
 };


 gpio@c600 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,master-en = <1>;
  qcom,out-strength = <1>;
  status = "ok";
 };


 gpio@c700 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,master-en = <1>;
  qcom,out-strength = <1>;
  status = "ok";
 };

};

&rpm_bus {
 rpm-regulator-ldoa19 {
  status = "okay";
  regulator-l19 {
   regulator-min-microvolt = <3008000>;
   regulator-max-microvolt = <3008000>;
   qcom,init-voltage = <3008000>;
   qcom,vdd-voltage-level = <3008000 3008000>;
   regulator-always-on;
   status = "okay";
  };
 };
};
# 20 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-connectivity.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-connectivity.dtsi"
&soc {
 bluetooth: bt_wcn3990 {
  compatible = "qca,wcn3990";
  qca,bt-vdd-io-supply = <&pm8998_s3>;
  qca,bt-vdd-xtal-supply = <&pm8998_s5>;
  qca,bt-vdd-core-supply = <&pm8998_l7>;
  qca,bt-vdd-pa-supply = <&pm8998_l17>;
  qca,bt-vdd-ldo-supply = <&pm8998_l25>;
  qca,bt-chip-pwd-supply = <&pmi8998_bob_pin1>;
  clocks = <&clock_gcc 0xa7c5602a>;
  clock-names = "rf_clk2";

  qca,bt-vdd-io-voltage-level = <1352000 1352000>;
  qca,bt-vdd-xtal-voltage-level = <2040000 2040000>;
  qca,bt-vdd-core-voltage-level = <1800000 1800000>;
  qca,bt-vdd-pa-voltage-level = <1304000 1304000>;
  qca,bt-vdd-ldo-voltage-level = <3312000 3312000>;
  qca,bt-chip-pwd-voltage-level = <3600000 3600000>;

  qca,bt-vdd-io-current-level = <1>;
  qca,bt-vdd-xtal-current-level = <1>;
  qca,bt-vdd-core-current-level = <1>;
  qca,bt-vdd-pa-current-level = <1>;
  qca,bt-vdd-ldo-current-level = <1>;
 };
};

&rpm_bus {
 rpm-regulator-ldoa18 {
  regulator-l18 {
   qcom,init-voltage = <2704000>;
   qcom,vdd-voltage-level = <2704000 2704000>;
   regulator-always-on;
  };
 };
};
# 21 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-nfc.dtsi" 1
# 14 "arch/arm64/boot/dts/lge/msm8998-taimen-nfc.dtsi"
&spi_1 {
 status = "ok";

 qcom,use-bam = <0>;

 ese@0 {
  compatible = "nxp,pn81a";
  reg = <0>;
  spi-max-frequency = <8000000>;



  nxp,nfcc = "8-0028";
  nxp,clear-n = <&tlmm 29 0x00>;
 };
};

&i2c_8 {
 status = "okay";
 qcom,nack-as-normal = <0x28>;
 nq@28 {
 compatible = "qcom,nq-nci";
 reg = <0x28>;
 interrupts = <92 0x4>;
 interrupt-parent = <&tlmm>;
 interrupt-names = "nfc_irq";
 clock-names = "ref_clk";
 qcom,clk-src = "BBCLK3";
 clocks = <&clock_gcc 0xc4de7dad>;
 qcom,nq-irq = <&tlmm 92 0x00>;
 qcom,nq-ven = <&tlmm 12 0x00>;
 qcom,nq-firm = <&tlmm 93 0x00>;
 qcom,nq-clkreq = <&pm8998_gpios 21 0x00>;
 qcom,nq-esepwr = <&tlmm 30 0x00>;
 qcom,nq-clear_n = <&tlmm 29 0x00>;
 qcom,nq-spi_cs = <&tlmm 2 0x00>;
 qcom,nq-postinit-cmd = /bits/ 8
  <0x5 0x20 0x02 0x05 0x01 0xA0 0xF2 0x01 0x01>;
 pinctrl-names = "nfc_active", "nfc_suspend";
 pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
 pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
 };
};

&pm8998_gpios {

 gpio@d400 {
  qcom,mode = <0>;
  qcom,vin-sel = <1>;
  qcom,src-sel = <0>;
  qcom,master-en = <1>;
  status = "okay";
 };
};


&pmi8998_gpios {
 gpio@c700 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,master-en = <1>;
  status = "ok";
 };
};


&pmi8998_gpios {

 gpio@c100 {
  qcom,master-en = <1>;
  qcom,out-strength = <3>;
  status = "okay";
 };
};
# 22 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-hdmi.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-hdmi.dtsi"
&soc {
 vibrator: vibrator@fd8c3420 {
  status = "disabled";
  compatible = "dongwoon,dw7800";
  vpwr-on = <0>;
 };
};
# 23 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-touch.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-touch.dtsi"
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-touch-stm-ftm4.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-touch-stm-ftm4.dtsi"
&pm8998_l28 {
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        qcom,init-voltage = <3300000>;
        status = "okay";
};

&pm8998_l6 {
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        qcom,init-voltage = <1800000>;
        status = "okay";
};

&i2c_5 {
 status = "disabled";
 qcom,clk-freq-out = <400000>;
 qcom,i2c-clk = <&tlmm 88 0>;
 qcom,i2c-dat = <&tlmm 87 0>;

 pinctrl-names = "i2c_active", "i2c_sleep", "i2c_bitbang";
 pinctrl-0 = <&i2c_5_active>;
 pinctrl-1 = <&i2c_5_sleep>;
 pinctrl-2 = <&i2c_5_bitbang>;

 ftm4_fts@49 {
  status = "ok";
  compatible = "stm,ftm4_fts";
  reg = <0x49>;

  interrupt-names = "tp_direct_interrupt";
  interrupts = <0 216 0>;

  pinctrl-names = "on_state","off_state";
  pinctrl-0 = <&ts_active>;
  pinctrl-1 = <&ts_suspend>;

  stm,switch_gpio= <&tlmm 75 0>;
  stm,irq_gpio = <&tlmm 125 0>;
  stm,irq_type = <0x2004>;
  stm,num_lines = <32 16>;
  stm,max_coords = <1439 2879>;
  stm,regulator_dvdd = "pm8998_l6";
  stm,regulator_avdd = "pm8998_l28";





  stm,reset-gpio = <&tlmm 89 0x0>;
  stm,ta_detect_gpio = <&tlmm 50 0x0>;

  stm,firmware_name = "ftm4_fw.ftb";

  power-supplies = <&pmi8998_charger>;
 };
};
# 14 "arch/arm64/boot/dts/lge/msm8998-taimen-touch.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-touch-sic-sw49408.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-touch-sic-sw49408.dtsi"
&soc {
 spi@c179000{
  status = "ok";
  compatible = "qcom,spi-qup-v2";

  #address-cells = <1>;
  #size-cells = <0>;

  reg-names = "spi_physical", "spi_bam_physical";
  reg = <0xC179000 0x600>, <0xC144000 0x25000>;

  interrupt-names = "spi_irq", "spi_bam_irq";
  interrupts = <0 99 0>, <0 238 0>;

  spi-max-frequency = <40000000>;
  qcom,master-id = <86>;

  clock-names = "iface_clk", "core_clk";
  clocks = <&clock_gcc 0x8caa5b4f>,
         <&clock_gcc 0xbf3e15d7>;


  qcom,use-pinctrl;
  pinctrl-names = "spi_default","spi_sleep";
  pinctrl-0 = <&spi_ts_active>;
  pinctrl-1 = <&spi_ts_suspend>;

  qcom,infinite-mode = <0>;
  qcom,ver-reg-exists;

  qcom,use-bam = <1>;
  qcom,bam-consumer-pipe-index = <14>;
  qcom,bam-producer-pipe-index = <15>;

  qcom,rt-priority;

  sw49408 {
   compatible = "lge,sw49408";
   reg = <1>;
   status = "ok";
   interrupt-parent = <&tlmm>;
   interrupts = <125 0x2008>;
   irqflags = <0x00000002>;
   spi-max-frequency = <40000000>;

   pinctrl-names = "touch_pin_active", "touch_pin_sleep";
   pinctrl-0 = <&ts_reset_active &ts_int_active>;
   pinctrl-1 = <&ts_reset_suspend1 &ts_int_suspend1>;

   reset-gpio = <&tlmm 89 0x00>;
   irq-gpio = <&tlmm 125 0x2008>;


   max_x = <1439>;
   max_y = <2879>;
   max_pressure = <0xff>;
   max_width_major = <1439>;
   max_width_minor = <2879>;
   max_orientation = <90>;
   max_id = <10>;
   hw_reset_delay = <90>;
   sw_reset_delay = <10>;


   use_lpwg = <1>;
   use_lpwg_test = <1>;
   hide_coordinate = <0>;


   fw_image = "touch/taimen/sw49408/L1L57P2_1_02.img",
     "touch/taimen/sw49408/L1L57P2_1_02.img";

   panel_spec = "touch/taimen/sw49408/taimen_limit.txt";
   panel_spec_mfts_folder = "touch/taimen/sw49408/taimen_limit_mfts.txt";


   use_asc = <0>;
   low_delta_thres = <350>;
   high_delta_thres = <600>;
   max_delta_cnt = <2>;
  };
 };
};
# 14 "arch/arm64/boot/dts/lge/msm8998-taimen-touch.dtsi" 2
# 24 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-fingerprint.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-fingerprint.dtsi"
&soc {
 fp_fpc1020 {
  status = "ok";
  compatible = "fpc,fpc1020";
  interrupt-parent = <&tlmm>;
  interrupts = <86 0x0>;
  fpc,gpio_rst = <&tlmm 128 0x0>;
  fpc,gpio_irq = <&tlmm 86 0x0>;

  vdd_io-supply = <&pm8998_s4>;




  pinctrl-names = "fpc1020_reset_reset",
   "fpc1020_reset_active",
   "fpc1020_irq_active";

  pinctrl-0 = <&msm_gpio_128>;
  pinctrl-1 = <&msm_gpio_128_output_high>;
  pinctrl-2 = <&msm_gpio_86>;
 };
};

&tlmm {

 msm_gpio_128: msm_gpio_128 {
  mux {
    pins = "gpio128";
    function = "gpio";
  };

  config {
   pins = "gpio128";
   drive-strength = <2>;
   bias-disable;
   output-low;
  };
 };


 msm_gpio_128_output_high: msm_gpio_128_output_high {
  mux {
   pins = "gpio128";
   function = "gpio";
  };

  config {
   pins = "gpio128";
   drive-strength = <2>;
   bias-disable;
   output-high;
  };
 };


 msm_gpio_86: msm_gpio_86 {
  mux {
   pins = "gpio86";
   function = "gpio";
  };

  config {
   pins = "gpio86";
   drive-strength = <2>;
   bias-pull-down;
  };
 };
};
