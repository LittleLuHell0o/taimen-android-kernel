# 1 "arch/arm64/boot/dts/lge/overlay-taimen-rev-0.dts"
# 1 "<built-in>" 1
# 1 "arch/arm64/boot/dts/lge/overlay-taimen-rev-0.dts" 2
# 13 "arch/arm64/boot/dts/lge/overlay-taimen-rev-0.dts"
/dts-v1/;
/plugin/;


# 1 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi"
# 1 "./arch/arm64/boot/dts/include/dt-bindings/clock/msm-clocks-8998.h" 1
# 16 "./arch/arm64/boot/dts/include/dt-bindings/clock/msm-clocks-8998.h"
# 1 "./arch/arm64/boot/dts/include/dt-bindings/clock/audio-ext-clk.h" 1
# 17 "./arch/arm64/boot/dts/include/dt-bindings/clock/msm-clocks-8998.h" 2
# 14 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
