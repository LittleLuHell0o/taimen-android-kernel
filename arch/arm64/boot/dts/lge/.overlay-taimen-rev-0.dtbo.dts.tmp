# 15 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-pinctrl.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-pinctrl.dtsi"
&soc {
 pinctrl@03400000 {
  spkr_i2s_clk_pin {
   spkr_i2s_clk_sleep {
    config {
     bias-disable;
     input-enable;
    };
   };
  };

  i2c_5 {
   i2c_5_sleep {
    config {
     bias-pull-up;
    };
   };
  };



  spi_1 {
   spi_1_active {
    mux {
     pins = "gpio0", "gpio1",
       "gpio2", "gpio3";
     function = "blsp_spi1";
    };

    config {
     pins = "gpio0", "gpio1",
       "gpio2", "gpio3";
     drive-strength = <6>;
     bias-disable;
    };
   };

   spi_1_sleep {
    mux {
     pins = "gpio0", "gpio1",
       "gpio2", "gpio3";
     function = "blsp_spi1";
    };

    config {
     pins = "gpio0", "gpio1",
       "gpio2", "gpio3";
     drive-strength = <6>;
     bias-pull-down;
    };
   };
  };

  spi_4 {
   spi_4_active {
    mux {
     pins = "gpio8", "gpio9",
       "gpio10", "gpio1";
    };

    config {
     pins = "gpio8", "gpio9",
       "gpio10", "gpio1";
    };
   };

   spi_4_sleep {
    mux {
     pins = "gpio8", "gpio9",
       "gpio10", "gpio1";
    };

    config {
     pins = "gpio8", "gpio9",
       "gpio10", "gpio1";
    };
   };
  };

  cam_sensor_rear_active {

   mux {
    pins = "gpio24";
   };

   config {
    pins = "gpio24";
   };
  };


  quat_mi2s {
   quat_mi2s_sleep {
    mux {
     function = "qua_mi2s";
    };
   };
  };

  quat_mi2s_sd0 {
   quat_mi2s_sd0_sleep {
    mux {
     function = "qua_mi2s";
    };
   };
  };

  quat_mi2s_sd1 {
   quat_mi2s_sd1_sleep {
    mux {
     pins = "gpio61";
     function = "qua_mi2s";
    };
   };
  };

  cam_sensor_rear_suspend {

   mux {
    pins = "gpio24";
   };

   config {
    pins = "gpio24";
   };
  };

  cam_sensor_front_active {

   mux {
    pins = "gpio23";
   };

   config {
    pins = "gpio23";
   };
  };

  cam_sensor_front_suspend {

   mux {
    pins = "gpio23";
   };

   config {
    pins = "gpio23";
   };
  };

  pmx_spi_tdmb {
   spi_tdmb_active {
    mux {
     pins = "gpio31", "gpio32", "gpio33", "gpio34";
     function = "blsp_spi2";
    };

    config {
     pins = "gpio31", "gpio32", "gpio33", "gpio34";
     drive-strength = <8>;
     bias-disable;
    };
   };

   spi_tdmb_suspend {
    mux {
     pins = "gpio31", "gpio32", "gpio33", "gpio34";
     function = "gpio";
    };

    config {
     pins = "gpio31", "gpio32", "gpio33", "gpio34";
     drive-strength = <2>;
     bias-pull-down;
    };
   };
  };

  pmx_gpio_tdmb_suspend {
   tdmb_int {
    mux {
     pins = "gpio95";
     function = "gpio";
    };
    config {
     pins = "gpio95";
     drive-strength = <8>;
     bias-pull-up;
    };
   };
   tdmb_ctrl {
    mux {
     pins = "gpio96";
     function = "gpio";
    };
    config {
     pins = "gpio96";
     drive-strength = <8>;
     bias-disable;
    };
   };
  };

  pmx_mdss {
   mdss_dsi_active {
    mux {
     pins = "gpio94", "gpio133", "gpio21";
    };

    config {
     pins = "gpio94", "gpio133", "gpio21";
    };
   };
   mdss_dsi_suspend {
    mux {
     pins = "gpio94", "gpio133", "gpio21";
    };

    config {
     pins = "gpio94", "gpio133", "gpio21";
    };
   };
  };
  poled_sw43402_int_active {
   mux {
    pins = "gpio11";
    function = "gpio";
   };

   config {
    pins = "gpio11";
    bias-pull-down;
    drive-strength = <2>;
   };
  };

  poled_sw43402_int_suspend {
   mux {
    pins = "gpio11";
    function = "gpio";
   };

   config {
    pins = "gpio11";
    bias-pull-down;
    drive-strength = <2>;
   };
  };


  hallic_gpio {
   label = "hallic_gpio";
   hallic_gpio_active: hallic_gpio_active {
    hallic_gpio {
     pins = "gpio124";
     drive-strength = <2>;
     bias-pull-up;
    };
   };
   hallic_gpio_suspend: hallic_gpio_suspend {
    hallic_gpio {
     pins = "gpio124";
     drive-strength = <2>;
     bias-pull-up;
    };
   };
  };

  ts_mux {
   ts_suspend: ts_suspend {
    mux {
     pins = "gpio89", "gpio125";
     function = "gpio";
    };

    config {
     pins = "gpio89", "gpio125";
     drive-strength = <2>;
     bias-pull-down;
    };
   };
  };

  pmx_ts_reset {
   ts_ftm4_reset_active {
    mux {
     pins = "gpio89";
     function = "gpio";
    };
    config {
     pins = "gpio89";
     drive-strength = <6>;
     bias-pull-up;
    };
   };

   ts_ftm4_reset_suspend {
    mux {
     pins = "gpio89";
     function = "gpio";
    };
    config {
     pins = "gpio89";
     drive-strength = <6>;
     bias-pull-down;
    };
   };
  };

  pmx_ts_int {
   ts_ftm4_int_active {
    mux {
     pins = "gpio125";
     function = "gpio";
    };
    config {
     pins = "gpio125";
     drive-strength = <2>;
     bias-pull-up;
    };
   };

   ts_ftm4_int_suspend {
    mux {
     pins = "gpio125";
     function = "gpio";
    };
    config {
     pins = "gpio125";
     drive-strength = <2>;
     bias-disable;
    };
   };
  };

  pmx_ts_reset_active {
   ts_reset_active {
    config {
     drive-strength = <6>;
    };
   };
  };

  pmx_ts_reset_suspend {
   ts_reset_suspend1 {
    config {
     drive-strength = <6>;
    };
   };
  };

  pmx_ts_int_active {
   ts_int_active {
    config {
     drive-strength = <2>;
    };
   };
  };

  pmx_ts_int_suspend {
   ts_int_suspend1 {
    config {
     bias-disable;
    };
   };
  };

  pmx_spi_ts {
   spi_ts_active: spi_ts_active {

    mux {
     pins = "gpio85", "gpio86",
       "gpio87", "gpio88";
     function = "blsp_spi5";
    };
    config {
     pins = "gpio85", "gpio86",
       "gpio87", "gpio88";
     drive-strength = <6>;
     bias-pull-up;
    };
   };

   spi_ts_suspend: spi_ts_suspend {

    mux {
     pins = "gpio85", "gpio86",
       "gpio87", "gpio88";
     function = "blsp_spi5";
    };
    config {
     pins = "gpio85", "gpio86",
       "gpio87", "gpio88";
     drive-strength = <6>;
     bias-disable;
    };
   };
  };
 };
};
# 16 "arch/arm64/boot/dts/lge/msm8998-taimen.dtsi" 2
# 1 "arch/arm64/boot/dts/lge/msm8998-taimen-misc.dtsi" 1
# 13 "arch/arm64/boot/dts/lge/msm8998-taimen-misc.dtsi"
&soc {
 gpio_keys {
  compatible = "gpio-keys";
  input-name = "gpio-keys";
  status = "okay";

  vol_up {
   label = "volume_up";
   gpios = <&tlmm 126 0x1>;
   linux,input-type = <1>;
   linux,code = <115>;
   gpio-key,wakeup;
   debounce-interval = <15>;
  };

 };
};
