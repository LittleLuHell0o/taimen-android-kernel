# 7 "arch/arm64/boot/dts/htc/msm8998-htc_muskie.dtsi" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-htc-nfc.dtsi" 1
&spi_1 {
 status = "ok";

 qcom,use-bam = <0>;

 ese@0 {
  compatible = "nxp,pn81a";
  reg = <0>;
  spi-max-frequency = <8000000>;



  nxp,nfcc = "8-0028";
  nxp,clear-n = <&tlmm 29 0x00>;
 };
};

&i2c_8 {
 qcom,nack-as-normal = <0x28>;
 nq@28 {
 compatible = "qcom,nq-nci";
 reg = <0x28>;
 interrupts = <92 0x4>;
 interrupt-parent = <&tlmm>;
 interrupt-names = "nfc_irq";
 clock-names = "ref_clk";
 qcom,clk-src = "BBCLK3";
 clocks = <&clock_gcc 0xc4de7dad>;
 qcom,nq-irq = <&tlmm 92 0x00>;
 qcom,nq-ven = <&tlmm 12 0x00>;
 qcom,nq-firm = <&tlmm 93 0x00>;
 qcom,nq-clkreq = <&pm8998_gpios 21 0x00>;
 qcom,nq-esepwr = <&tlmm 30 0x00>;
 qcom,nq-clear_n = <&tlmm 29 0x00>;
 qcom,nq-spi_cs = <&tlmm 2 0x00>;
 qcom,nq-postinit-cmd = /bits/ 8
  <0x5 0x20 0x02 0x05 0x01 0xA0 0xF2 0x01 0x01>;
 pinctrl-names = "nfc_active", "nfc_suspend";
 pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
 pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
 };
};

&pm8998_gpios {

 gpio@d400 {
  qcom,mode = <0>;
  qcom,vin-sel = <1>;
  qcom,src-sel = <0>;
  qcom,master-en = <1>;
  status = "okay";
 };
};


&pmi8998_gpios {
 gpio@c700 {
  qcom,mode = <1>;
  qcom,pull = <4>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,invert = <0>;
  qcom,master-en = <1>;
  status = "ok";
 };
};
# 8 "arch/arm64/boot/dts/htc/msm8998-htc_muskie.dtsi" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-camera-laser-muskie.dtsi" 1
# 14 "arch/arm64/boot/dts/htc/msm8998-camera-laser-muskie.dtsi"
&tlmm {
 laser_sensor {
         laser_pwdn:laser_pwdn {
                 config {
                           pins = "gpio39";
                         drive-strength = <2>;
                         bias-disable;
                 };
         };
         laser_int:laser_int {
                 config {
                         pins = "gpio62";
                         drive-strength = <2>;
                         bias-disable;
                 };
         };
 };
};

&i2c_9 {
 wahoo_laser@29 {
  compatible = "wahoo_laser";
  reg = <0x29>;
  pinctrl-names = "laser_gpio_init";
  pinctrl-0 = <&laser_pwdn &laser_int>;
  power_2v8-supply = <&pm8998_l19>;
  CAMIO_1v8-supply = <&pm8998_lvs1>;
  interrupt-parent = <&tlmm>;
  interrupts = <62 0x0>;
  laser,intr-gpio = <&tlmm 62 0>;
  laser,pwdn-gpio = <&tlmm 39 0>;
 };
};
# 9 "arch/arm64/boot/dts/htc/msm8998-htc_muskie.dtsi" 2

&wil6210 {
 status = "disabled";
};

&mdss_dsi0 {
 qcom,dsi-pref-prim-pan = <&dsi_s6e3ha3_dualdsi_wqhd_cmd>;
 lab-supply = <>;
 ibb-supply = <>;
 wqhd-vddio-supply = <&pm8998_l14>;
 vci-supply = <&pm8998_l22>;
 pinctrl-names = "mdss_default", "mdss_sleep";
 pinctrl-0 = <&mdss_dsi_active &mdss_te_active>;
 pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
 qcom,platform-reset-gpio = <&tlmm 94 0>;
 qcom,platform-te-gpio = <&tlmm 10 0>;
 qcom,platform-err_fg-gpio = <&pmi8998_gpios 14 0>;
};

&mdss_dsi1 {
 qcom,dsi-pref-prim-pan = <&dsi_s6e3ha3_dualdsi_wqhd_cmd>;
 lab-supply = <>;
 ibb-supply = <>;
 wqhd-vddio-supply = <&pm8998_l14>;
 vci-supply = <&pm8998_l22>;
 pinctrl-names = "mdss_default", "mdss_sleep";
 pinctrl-0 = <&mdss_dsi_active &mdss_te_active>;
 pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
 qcom,platform-reset-gpio = <&tlmm 94 0>;
 qcom,platform-te-gpio = <&tlmm 10 0>;
 qcom,platform-err_fg-gpio = <&pmi8998_gpios 14 0>;
};

&pm8998_l14 {
 regulator-min-microvolt = <1800000>;
 regulator-max-microvolt = <1800000>;
};

&pm8998_l22 {
 regulator-min-microvolt = <3000000>;
 regulator-max-microvolt = <3000000>;
};

&tlmm {
 pmx_mdss {
  mdss_dsi_active {
   mux {
    pins = "gpio94";
    function = "gpio";
   };
    config {
    pins = "gpio94";
    drive-strength = <2>;
    bias-disable = <0>;
   };
  };
  mdss_dsi_suspend {
   mux {
    pins = "gpio94";
    function = "gpio";
   };
    config {
    pins = "gpio94";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

 pmx_mdss_te {
  mdss_te_active {
   mux {
    pins = "gpio10";
    function = "mdp_vsync_a";
   };
   config {
    pins = "gpio10";
    drive-strength = <2>;
    bias-pull-down;
   };
  };

  mdss_te_suspend {
   mux {
    pins = "gpio10";
    function = "gpio";
   };
   config {
    pins = "gpio10";
    drive-strength = <2>;
    bias-pull-down;
    input-enable;
   };
  };
 };

 spkr_i2s_clk_pin {
  spkr_i2s_clk_sleep {
   config {
    bias-disable;
    input-enable;
   };
  };
 };
};

&pmi8998_gpios {
 gpio@cd00 {
  reg = <0xcd00 0x100>;
  qcom,mode = <0>;
  qcom,pull = <5>;
  qcom,pin-num = <14>;
  status = "okay";
 };
};
&pmi8998_wled {
 status = "disabled";
};
&labibb {
 status = "disabled";
};
&mdss_fb2 {
 status = "disabled";
};
&mdss_hdmi_tx {
 status = "disabled";
};
&mdss_fb3 {
 status = "disabled";
};
&mdss_dp_ctrl {
 status = "disabled";
};

&pm8998_vadc {
 chan@4e {
  label = "fpc_therm";
  reg = <0x4e>;
  qcom,decimation = <2>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <2>;
  qcom,hw-settle-time = <2>;
  qcom,fast-avg-setup = <0>;
 };

 chan@4f {
  label = "back_therm";
  reg = <0x4f>;
  qcom,decimation = <2>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <2>;
  qcom,hw-settle-time = <2>;
  qcom,fast-avg-setup = <0>;
 };

 chan@50 {
  label = "pa_therm";
  reg = <0x50>;
  qcom,decimation = <2>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <2>;
  qcom,hw-settle-time = <2>;
  qcom,fast-avg-setup = <0>;
 };
};

&pm8998_adc_tm {
 chan@4e {
  label = "fpc_therm";
  reg = <0x4e>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <4>;
  qcom,hw-settle-time = <2>;
  qcom,btm-channel-number = <0x80>;
  qcom,thermal-node;
 };

 chan@4f {
  label = "back_therm";
  reg = <0x4f>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <4>;
  qcom,hw-settle-time = <2>;
  qcom,btm-channel-number = <0x88>;
  qcom,thermal-node;
 };

 chan@50 {
  label = "pa_therm";
  reg = <0x50>;
  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <4>;
  qcom,hw-settle-time = <2>;
  qcom,btm-channel-number = <0x90>;
  qcom,thermal-node;
 };
};

&soc {
 qcom,sensor-information {
  sensor_information30: qcom,sensor-information-30 {
   qcom,sensor-type = "adc";
   qcom,sensor-name = "fpc_therm";
  };
  sensor_information31: qcom,sensor-information-31 {
   qcom,sensor-type = "adc";
   qcom,sensor-name = "back_therm";
  };
  sensor_information32: qcom,sensor-information-32 {
   qcom,sensor-type = "adc";
   qcom,sensor-name = "pa_therm";
  };
 };

 htc,htc-battery {
