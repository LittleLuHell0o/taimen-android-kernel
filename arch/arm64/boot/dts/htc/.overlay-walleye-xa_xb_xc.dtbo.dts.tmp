# 18 "arch/arm64/boot/dts/htc/overlay-walleye-xa_xb_xc.dts" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-touch-walleye-xa.dtsi" 1
# 1 "arch/arm64/boot/dts/htc/msm8998-touch-mw-common.dtsi" 1
&pm8998_l28 {
 regulator-min-microvolt = <3300000>;
 regulator-max-microvolt = <3300000>;
 qcom,init-voltage = <3300000>;
 status = "okay";
 regulator-boot-on;
 regulator-always-on;
};

&tlmm {
 pmx_ts {
  ts_intr_active:ts_intr_active {
   mux {
    pins = "gpio125";
    function = "gpio";
   };

   config {
    pins = "gpio125";
    drive-strength = <2>;
    bias-pull-up;
   };
  };
  ts_intr_suspend:ts_intr_suspend {
   mux {
    pins = "gpio125";
    function = "gpio";
   };

   config {
    pins = "gpio125";
    drive-strength = <2>;
    bias-pull-up;
   };
  };

  ts_rst_active:ts_rst_active {
   mux {
    pins = "gpio89";
    function = "gpio";
   };

   config {
    pins = "gpio89";
    drive-strength = <2>;
    bias-disable;
    output-high;
   };
  };
  ts_rst_suspend:ts_rst_suspend {
   mux {
    pins = "gpio89";
    function = "gpio";
   };

   config {
    pins = "gpio89";
    drive-strength = <2>;
    bias-disable;
    output-high;
   };
  };
 };

 i2c_5 {
  i2c_5_active {
   mux {
    pins = "gpio87", "gpio88";
    function = "blsp_i2c5";
   };

   config {
    pins = "gpio87", "gpio88";
    drive-strength = <8>;
    bias-disable;
   };
  };

  i2c_5_sleep {
   mux {
    pins = "gpio87", "gpio88";
    function = "blsp_i2c5";
   };

   config {
    pins = "gpio87", "gpio88";
    drive-strength = <8>;
    bias-disable;
   };
  };
 };
};

&aliases {
 i2c5 = "/soc/i2c@c179000";
};

&soc {
 i2c@c179000 {
  compatible = "qcom,i2c-msm-v2";
  #address-cells = <1>;
  #size-cells = <0>;
  reg-names = "qup_phys_addr";
  reg = <0xC179000 0x600>;
  interrupt-names = "qup_irq";
  interrupts = <0 99 0>;
  dmas = <&dma_blsp1 14 64 0x20000020 0x20>,
   <&dma_blsp1 15 32 0x20000020 0x20>;
  dma-names = "tx", "rx";
  qcom,master-id = <86>;
  qcom,clk-freq-out = <400000>;
  qcom,clk-freq-in = <19200000>;
  qcom,i2c-clk = <&tlmm 88 0>;
  qcom,i2c-dat = <&tlmm 87 0>;
  clock-names = "iface_clk", "core_clk";
  clocks = <&clock_gcc 0x8caa5b4f>,
   <&clock_gcc 0xacae5604>;
  pinctrl-names = "i2c_active", "i2c_sleep", "i2c_bitbang";
  pinctrl-0 = <&i2c_5_active>;
  pinctrl-1 = <&i2c_5_sleep>;
  pinctrl-2 = <&i2c_5_bitbang>;
  status = "okay";
 };
};

&i2c_5 {
 synaptics_dsx@20 {
  compatible = "synaptics,dsx-i2c";
  reg = <0x20>;
  interrupt-names = "tp_direct_interrupt";
  interrupts = <0 216 0>;
  synaptics,irq-gpio = <&tlmm 125 0x2008>;
  synaptics,reset-gpio = <&tlmm 89 0x00>;
  synaptics,reset-on-state = <0>;
  synaptics,reset-active-ms = <1>;
  synaptics,reset-delay-ms = <20>;
  synaptics,switch-gpio = <&tlmm 75 0x00>;
  synaptics,update-feature = <1>;
  synaptics,tw-pin-mask = <0x3>;
  synaptics,tp-src-id = <0x0 0x1 0x2 0x3>;
  synaptics,tp-src-img = "synaptics_0.img", "synaptics_1.img",
     "synaptics_2.img", "synaptics_3.img";
  pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
  pinctrl-0 = <&ts_rst_active &ts_intr_active>;
  pinctrl-1 = <&ts_rst_suspend &ts_intr_suspend>;
 };
};
# 2 "arch/arm64/boot/dts/htc/msm8998-touch-walleye-xa.dtsi" 2

&pm8998_l6 {
 regulator-min-microvolt = <1800000>;
 regulator-max-microvolt = <1900000>;
 qcom,init-voltage = <1800000>;
 status = "okay";
 regulator-boot-on;
 regulator-always-on;
};

&i2c_5 {
 synaptics_dsx@20 {
  synaptics,display-coords = <0 1080 0 1920>;
 };
};
# 19 "arch/arm64/boot/dts/htc/overlay-walleye-xa_xb_xc.dts" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-htc-led-xa.dtsi" 1
&pmi8998_gpios {
 gpio@c800 {
  qcom,mode = <1>;
  qcom,output-type = <0>;
  qcom,invert = <1>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,out-strength = <1>;
  qcom,master-en = <1>;
  status = "okay";
 };
};
&i2c_7 {
 lp5562@30 {
  compatible = "ti,lp5562";
  reg = <0x30>;
  clock-mode = /bits/8 <2>;
  enable-gpio =<&pm8998_gpios 18 0x00>;
  chan0 {
   chan-name = "red";
   led-cur = /bits/ 8 <0x20>;
   max-cur = /bits/ 8 <0x60>;
  };

  chan1 {
   chan-name = "green";
   led-cur = /bits/ 8 <0x20>;
    max-cur = /bits/ 8 <0x60>;
  };

  chan2 {
   chan-name = "blue";
   led-cur = /bits/ 8 <0x20>;
   max-cur = /bits/ 8 <0x60>;
  };
 };
};
# 20 "arch/arm64/boot/dts/htc/overlay-walleye-xa_xb_xc.dts" 2

