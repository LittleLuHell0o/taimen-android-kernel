  qcom,pre-div-channel-scaling = <0>;
  qcom,calibration-type = "ratiometric";
  qcom,scale-function = <4>;
  qcom,hw-settle-time = <2>;
  qcom,btm-channel-number = <0x78>;
  qcom,thermal-node;
 };
};

&wil6210 {
 status = "ok";
};

&soc {
 gpio_keys {
  compatible = "gpio-keys";
  input-name = "gpio-keys";
  status = "okay";

  vol_up {
   label = "volume_up";
   gpios = <&pm8998_gpios 6 0x1>;
   linux,input-type = <1>;
   linux,code = <115>;
   gpio-key,wakeup;
   debounce-interval = <15>;
  };
 };
};
# 16 "arch/arm64/boot/dts/htc/msm8998-v2.1-htc_mw-common-overlay.dtsi" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-htc_muskie.dtsi" 1
# 1 "arch/arm64/boot/dts/htc/msm8998-htc-common.dtsi" 1




# 1 "arch/arm64/boot/dts/htc/msm8998-key-muskie.dtsi" 1
&soc {
 gpio_keys {
  compatible = "gpio-keys";
  input-name = "gpio-keys";
  status = "okay";
  pinctrl-names = "tlmm_gpio_key_active","tlmm_gpio_key_suspend";
  pinctrl-0 = <&gpio_key_active>;
  pinctrl-1 = <&gpio_key_suspend>;
  use-syscore;

  power_key {
   label = "power_key";
   gpios = <&tlmm 40 0x1>;
   linux,input-type = <1>;
   linux,code = <116>;
   gpio-key,wakeup;
   debounce-interval = <20>;
  };

  vol_up {
   label = "volume_up";
   gpios = <&tlmm 126 0x1>;
   linux,input-type = <1>;
   linux,code = <115>;
   gpio-key,wakeup;
   debounce-interval = <20>;
  };

  vol_down {
   label = "volume_down";
   gpios = <&tlmm 121 0x1>;
   linux,input-type = <1>;
   linux,code = <114>;
   gpio-key,wakeup;
   debounce-interval = <20>;
  };
 };
};

&spmi_bus {
 qcom,pm8998@0 {
  qcom,power-on@800 {
   qcom,report-key = <0>;
  };
 };
};

&tlmm {
 gpio_key {
  gpio_key_active: gpio_key_active {
   mux {
    pins = "gpio40", "gpio121", "gpio126";
    function = "gpio";
   };
   config {
    pins = "gpio40", "gpio121", "gpio126";
    drive-strength = <2>;
    bias-disable;
   };
  };
  gpio_key_suspend: gpio_key_suspend {
   mux {
    pins = "gpio40", "gpio121", "gpio126";
    function = "gpio";
   };
   config {
    pins = "gpio40", "gpio121", "gpio126";
    drive-strength = <2>;
    bias-disable;
   };
  };
 };
};
# 6 "arch/arm64/boot/dts/htc/msm8998-htc-common.dtsi" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-audio-muskie.dtsi" 1
&spi_2 {
 status = "ok";
};

&pm8998_gpios {

  gpio@c500 {
   qcom,mode = <1>;
   qcom,master-en = <0x1>;
  };

  gpio@c600 {
   qcom,pull = <4>;
  };

  gpio@c700 {
   qcom,pull = <4>;
  };
};

&soc {
 sound-9335 {
  status = "disabled";
  qcom,audio-routing =
   "AIF4 VI", "MCLK",
   "RX_BIAS", "MCLK",
   "MADINPUT", "MCLK",
   "AMIC2", "MIC BIAS2",
   "MIC BIAS2", "Headset Mic",
   "AMIC3", "MIC BIAS2",
   "MIC BIAS2", "ANCRight Headset Mic",
   "AMIC4", "MIC BIAS2",
   "MIC BIAS2", "ANCLeft Headset Mic",
   "AMIC5", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic",
   "AMIC6", "MIC BIAS4",
   "MIC BIAS4", "Analog Mic6",
   "DMIC0", "MIC BIAS1",
   "MIC BIAS1", "Handset Mic",
   "DMIC1", "MIC BIAS1",
   "MIC BIAS1", "Handset Mic",
   "DMIC2", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic",
   "DMIC3", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic",
   "DMIC4", "MIC BIAS4",
   "MIC BIAS4", "Handset Mic",
   "DMIC5", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic",
   "SpkrLeft IN", "SPK1 OUT",
   "SpkrRight IN", "SPK2 OUT";

  qcom,msm-mbhc-hphl-swh = <1>;
  qcom,msm-mbhc-gnd-swh = <1>;
  qcom,wsa-max-devs = <0>;

  wahoo,use-external-amp;
  wahoo,external-amp-be-sname = "Quaternary MI2S Playback",
           "Tertiary MI2S Playback";
  wahoo,external-amp-be-codec-phandle = <&nxp_tfa98xx_34>,
            <&nxp_tfa98xx_35>;
  wahoo,external-amp-be-codec-dai-name = "tfa98xx-aif-7-34",
             "tfa98xx-aif-7-35";
 };

 sound-tavil {
  qcom,audio-routing =
   "RX_BIAS", "MCLK",
   "MADINPUT", "MCLK",
   "DMIC1", "MIC BIAS1",
   "MIC BIAS1", "Handset Mic",
   "DMIC2", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic",
   "DMIC3", "MIC BIAS3",
   "MIC BIAS3", "Handset Mic";

  qcom,wsa-max-devs = <0>;

  wahoo,use-external-amp;
  wahoo,external-amp-be-sname = "Quaternary MI2S Playback";

  wahoo,external-amp-be-codec-phandle = <&ti_tas2557_4d>;

  wahoo,external-amp-be-codec-dai-name = "tas2557 Stereo ASI1";
 };

 i2c@c1b5000 {
  nxp_tfa98xx_34: nxp_tfa98xx_amp@34 {
    compatible = "nxp,tfa98xx";
    reg = <0x34>;
    reset-gpio = <&pm8998_gpios 6 0x1>;
    upper-spk;
    status = "disabled";
  };

  nxp_tfa98xx_35: nxp_tfa98xx_amp@35 {
    compatible = "nxp,tfa98xx";
    reg = <0x35>;
    reset-gpio = <&pm8998_gpios 7 0x1>;
    status = "disabled";
  };

  ti_tas2557_4d: tas2557s@4d {
    #sound-dai-cells = <1>;
    compatible = "ti,tas2557s";
    reg = <0x4d>;
    ti,reset-gpio-left = <&pm8998_gpios 6 0>;
    ti,reset-gpio-right = <&pm8998_gpios 6 0>;
    ti,irq-gpio-left = <&pm8998_gpios 7 0>;
    ti,irq-gpio-right = <&pm8998_gpios 8 0>;
    ti,left-channel = <0x4c>;
    ti,right-channel = <0x4d>;
    ti,echo-ref = <0>;
    ti,i2s-bits = <24>;
    ti,bypass-tmax = <0>;
    ti,bob-fast-profile = <1>;
    status = "ok";
  };
 };

 qcom,msm-dai-mi2s {
  qcom,msm-dai-q6-mi2s-quat {
   qcom,msm-mi2s-rx-lines = <2>;
   qcom,msm-mi2s-tx-lines = <1>;
   qcom,msm-mi2s-slave = <0>;
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&quat_mi2s_active
         &quat_mi2s_sd0_active
         &quat_mi2s_sd1_active>;
   pinctrl-1 = <&quat_mi2s_sleep
         &quat_mi2s_sd0_sleep
         &quat_mi2s_sd1_sleep>;
  };
 };

 audio_ext_clk_lnbb {
  status = "disabled";
 };
};


&wcd_usbc_analog_en1_gpio {
 status = "disabled";
};


&wcd_usbc_analog_en2n_gpio {
 status = "disabled";
};

&slim_aud {
 tasha_codec {
  status = "disabled";
  swr_master {
   status = "disabled";
  };
 };

 tavil_codec {
  clocks = <&clock_audio 0xcbfe416d>;
  qcom,cdc-dmic-clk-drv-strength = <4>;
  wcd_spi {
   qcom,master-bus-num = <2>;
  };
  swr_master {
   status = "disabled";
  };
 };
};
