  qcom,output-type = <0>;
  qcom,invert = <1>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,out-strength = <1>;
  qcom,master-en = <1>;
  status = "okay";
 };
};

&pmi8998_gpios {
 gpio@c800 {
  qcom,mode = <1>;
  qcom,output-type = <0>;
  qcom,invert = <1>;
  qcom,vin-sel = <0>;
  qcom,src-sel = <0>;
  qcom,out-strength = <1>;
  qcom,master-en = <1>;
  status = "okay";
 };
};

&soc {
 tps61099 {
  compatible = "ti,tps61099";
  uses_gpio;

  enable-gpios = <&pm8998_gpios 5 0>;

  tps61099_vbus: ti,tps61099 {
   regulator-name = "tps61099-vbus";
  };
 };
};

&pmi8998_charger {
 qcom,hvdcp-disable;
 qcom,usb-icl-ua = <1500000>;
 external-vbus-supply = <&tps61099_vbus>;





 qcom,fcc-max-ua = <500000>;
};

&pmi8998_pdphy {
 src-pdo = <0x0 5000 900 0>;
 snk-pdo = <0x0 5000 3000 0>,
    <0x0 9000 3000 0>;
 max-snk-mv = <9000>;
 max-snk-ma = <3000>;
 max-snk-mw = <27000>;
 op-snk-mw = <7600>;
 port-type = <0x2>;
 default-role = <0x0>;
 try-role-hw;
};

&qusb_phy0 {
 qcom,qusb-phy-init-seq =

    <0x13 0x04
    0x7c 0x18c
    0x80 0x2c
    0x0a 0x184
    0xf5 0x23c
    0x0b 0x240
    0xe4 0x248
    0x19 0xb4>;
 skip_efuse_reg;
};

&soc {
 ptn36241g {
  compatible = "nxp,ptn36241g";
  extcon = <&pmi8998_pdphy>;

  pinctrl-names = "nxp_vdd_active", "nxp_vdd_sleep",
    "nxp_cc1_active-HH", "nxp_cc1_sleep-LL",
    "nxp_cc2_active-HH", "nxp_cc2_sleep-LL";

  pinctrl-0 = <&nxp_vdd_active>;

  pinctrl-1 = <&nxp_vdd_sleep>;

  pinctrl-2 = <&nxp_cc1_c1_High &nxp_cc1_c2_HighZ>;

  pinctrl-3 = <&nxp_cc1_c1_Low &nxp_cc1_c2_Low>;

  pinctrl-4 = <&nxp_cc2_c1_High &nxp_cc2_c2_HighZ>;

  pinctrl-5 = <&nxp_cc2_c1_Low &nxp_cc2_c2_Low>;
 };
};

&tlmm {
 nxp_vdd_active: nxp_vdd_active {
  config {
   pins = "gpio49";
   bias-disable;
   output-high;
  };
 };

 nxp_vdd_sleep: nxp_vdd_sleep {
  config {
   pins = "gpio49";
   bias-disable;
   output-low;
  };
 };

 nxp_cc1_pinctrl {
  nxp_cc1_c1_High: nxp_cc1_c1_High {
   config {
    pins = "gpio41";
    bias-disable;
    output-high;
   };
  };

  nxp_cc1_c1_Low: nxp_cc1_c1_Low {
   config {
    pins = "gpio41";
    bias-disable;
    output-low;
   };
  };

  nxp_cc1_c1_HighZ: nxp_cc1_c1_HighZ {
   config {
    pins = "gpio41";
    bias-disable;
   };
  };

  nxp_cc1_c2_High: nxp_cc1_c2_High {
   config {
    pins = "gpio42";
    bias-disable;
    output-high;
   };
  };

  nxp_cc1_c2_Low: nxp_cc1_c2_Low {
   config {
    pins = "gpio42";
    bias-disable;
    output-low;
   };
  };

  nxp_cc1_c2_HighZ: nxp_cc1_c2_HighZ {
   config {
    pins = "gpio42";
    bias-disable;
   };
  };
 };

 nxp_cc2_pinctrl {
  nxp_cc2_c1_High: nxp_cc2_c1_High {
   config {
    pins = "gpio76";
    bias-disable;
    output-high;
   };
  };

  nxp_cc2_c1_Low: nxp_cc2_c1_Low {
   config {
    pins = "gpio76";
    bias-disable;
    output-low;
   };
  };

  nxp_cc2_c1_HighZ: nxp_cc2_c1_HighZ {
   config {
    pins = "gpio76";
    bias-disable;
   };
  };

  nxp_cc2_c2_High: nxp_cc2_c2_High {
   config {
    pins = "gpio77";
    bias-disable;
    output-high;
   };
  };

  nxp_cc2_c2_Low: nxp_cc2_c2_Low {
   config {
    pins = "gpio77";
    bias-disable;
    output-low;
   };
  };

  nxp_cc2_c2_HighZ: nxp_cc2_c2_HighZ {
   config {
    pins = "gpio77";
    bias-disable;
   };
  };
 };
};


&pm8998_gpios {
