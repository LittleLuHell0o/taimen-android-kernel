# 1 "arch/arm64/boot/dts/htc/base-msm8998-mtp.dtsi" 1
# 13 "arch/arm64/boot/dts/htc/base-msm8998-mtp.dtsi"
# 1 "./arch/arm64/boot/dts/include/dt-bindings/interrupt-controller/irq.h" 1
