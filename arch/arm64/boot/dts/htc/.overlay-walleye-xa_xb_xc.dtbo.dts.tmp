   config {
    pins = "gpio24";
    bias-disable;
    drive-strength = <2>;
    output-low;
   };
  };

  cam_sensor_front_active {

   mux {
    pins = "gpio23";
    function = "gpio";
   };

   config {
    pins = "gpio23";
    bias-disable;
    drive-strength = <2>;
    output-low;
   };
  };

  cam_sensor_front_suspend {

   mux {
    pins = "gpio23";
    function = "gpio";
   };
   config {
    pins = "gpio23";
    bias-disable;
    drive-strength = <2>;
    output-low;
   };
  };

  cam_sensor_mclk0_active {

   mux {

    pins = "gpio13";
    function = "cam_mclk";
   };

   config {
    pins = "gpio13";
    bias-disable;
    drive-strength = <8>;
   };
  };

  cam_sensor_mclk0_suspend {

   mux {

    pins = "gpio13";
    function = "gpio";
   };

   config {
    pins = "gpio13";
    bias-pull-down;
    drive-strength = <8>;
    output-low;
   };
  };

  cam_sensor_mclk1_active {

   mux {

    pins = "gpio14";
    function = "cam_mclk";
   };

   config {
    pins = "gpio14";
    bias-disable;
    drive-strength = <8>;
   };
  };

  cam_sensor_mclk1_suspend {

   mux {

    pins = "gpio14";
    function = "gpio";
   };

   config {
    pins = "gpio14";
    bias-pull-down;
    drive-strength = <8>;
    output-low;
   };
  };

  cam_sensor_vsync_active: cam_sensor_vsync_active {

   mux {
    pins = "gpio80";
    function = "gpio";
   };

   config {
    pins = "gpio80";
    bias-pull-down;
    drive-strength = <2>;
    input-enable;
   };
  };

  cam_sensor_vsync_suspend: cam_sensor_vsync_suspend {

   mux {
    pins = "gpio80";
