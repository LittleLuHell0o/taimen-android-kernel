# 21 "arch/arm64/boot/dts/htc/msm8998-v2.1-htc_mw-common-overlay.dtsi" 2
# 1 "arch/arm64/boot/dts/htc/msm8998-htc-fingerprint-muskie-xa.dtsi" 1
# 17 "arch/arm64/boot/dts/htc/msm8998-htc-fingerprint-muskie-xa.dtsi"
&tlmm {
 fpc1020_reset {
  fpc1020_reset_reset: reset {
   mux {
    pins = "gpio128";
    function = "gpio";
   };

   config {
    pins = "gpio128";
    drive-strength = <2>;
    bias-disable;
    output-low;
   };
  };
  fpc1020_reset_active: active {
   mux {
    pins = "gpio128";
    function = "gpio";
   };

   config {
    pins = "gpio128";
    drive-strength = <2>;
    bias-disable;
    output-high;
   };
  };
 };

 fpc1020_irq_active {
  fpc1020_irq_active: active {
   mux {
    pins = "gpio86";
    function = "gpio";
   };

   config {
    pins = "gpio86";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };
};

&soc {
 fp_fpc1020 {
  compatible = "fpc,fpc1020";
  interrupt-parent = <&tlmm>;
  interrupts = <86 0x0>;
  fpc,gpio_rst = <&tlmm 128 0>;
  fpc,gpio_irq = <&tlmm 86 0>;
  pinctrl-names =
       "fpc1020_irq_active",
       "fpc1020_reset_reset",
       "fpc1020_reset_active";

  pinctrl-0 = <&fpc1020_irq_active>;
  pinctrl-1 = <&fpc1020_reset_reset>;
  pinctrl-2 = <&fpc1020_reset_active>;
 };
};
